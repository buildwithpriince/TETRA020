# --- AI ---
GEMINI_API_KEY=

# --- Firebase Admin ---
# Path to a Firebase service account JSON file, OR paste the JSON directly
# into FIREBASE_CREDENTIALS_JSON (useful for platforms like Render where you
# set env vars but can't easily mount a file).
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=

# --- Session store ---
# If REDIS_URL is set, sessions are stored in Redis. Otherwise falls back to
# an in-process dict (fine for a single instance, lost on restart).
REDIS_URL=
SESSION_TTL_SECONDS=3600

# --- CORS ---
# Comma-separated list of allowed origins. No wildcards in production.
ALLOWED_ORIGINS=http://localhost:5173

# --- PDF report ---
# Password applied to generated report PDFs. If unset, a random one is
# generated per-report and returned only to the requesting caller is NOT
# supported by the contract (the endpoint just streams the PDF), so set a
# real value here in production.
REPORT_PDF_PASSWORD=

# --- Limits ---
MAX_UPLOAD_SIZE_MB=25
MAX_FILES_PER_UPLOAD=10

# --- Rate limiting ---
UPLOAD_RATE_LIMIT=10/minute
ANALYZE_RATE_LIMIT=5/minute
