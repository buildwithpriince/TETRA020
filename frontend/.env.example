# Copy this file to frontend/.env and fill in real values.
# `docker-compose.yml` loads frontend/.env automatically via env_file.
# For local (non-docker) `yarn dev`, Vite also picks up frontend/.env directly.

# Base URL for the backend API. Leave unset/empty to run the frontend
# entirely on mock data (no backend calls).
VITE_API_BASE_URL=http://localhost:8001

# Firebase Web SDK config — required for real "Sign in with Google".
# Get these from Firebase Console -> Project Settings -> Your apps -> Web app.
# If any of these three are left empty, the app silently falls back to a
# fake "demo-analyst" sign-in instead of a real Google popup.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
