# Copy this file to backend/.env and fill in real values.
# `docker-compose.yml` loads backend/.env automatically via env_file.

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Model used for extraction. gemini-2.5-flash-lite is no longer available
# to new API keys, so gemini-flash-lite-latest is the default.
GEMINI_MODEL=gemini-flash-lite-latest

# Path (inside the container) to a Firebase Admin service-account JSON key.
# Generate one in Firebase Console -> Project Settings -> Service accounts
# -> Generate new private key. Save it as backend/firebase-service-account.json
# (already gitignored) — the Dockerfile's `COPY . .` will bundle it into the
# image automatically at build time, no extra volume mount needed.
FIREBASE_SERVICE_ACCOUNT_JSON=/app/firebase-service-account.json

# SQLAlchemy DB URL.
DATABASE_URL=sqlite:///./prism.db
